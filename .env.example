# =====================================================
# MortgageDealsHub Environment Variables
# =====================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# =====================================================
# Flask Configuration
# =====================================================
FLASK_ENV=development
# IMPORTANT: Generate a strong SECRET_KEY for production!
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# =====================================================
# Database Configuration
# =====================================================
# For local development, SQLite is used automatically
# For production (Railway, Heroku, etc.), set this to your PostgreSQL URL
# DATABASE_URL=postgresql://user:password@host:port/database

# =====================================================
# Email Configuration (Flask-Mail)
# =====================================================
# For Gmail, you need to create an "App Password"
# https://support.google.com/accounts/answer/185833
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# =====================================================
# Stripe Configuration
# =====================================================
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (from Stripe Dashboard -> Products)
STRIPE_YEARLY_PRICE_ID=price_1STXcVD2EDcoPFLNECjwrN1p
STRIPE_MONTHLY_PRICE_ID=price_1STXbDD2EDcoPFLN6hEU2gS9

# =====================================================
# Site Configuration
# =====================================================
SITE_URL=https://mortgagedealshub.co.uk

# =====================================================
# Optional: Scheduler Configuration
# =====================================================
# Set to 1 to enable the background scheduler for deal refresh
# Only enable on ONE process if using Gunicorn with multiple workers
SCHEDULER_ENABLED=1

# =====================================================
# SETUP INSTRUCTIONS
# =====================================================
# 1. Copy this file: cp .env.example .env
# 2. Generate a secure SECRET_KEY:
#    python -c "import secrets; print(secrets.token_hex(32))"
# 3. Set up Stripe account and get API keys
# 4. Configure email (Gmail App Password or SMTP)
# 5. For production: Set DATABASE_URL, FLASK_ENV=production
# 6. Configure Stripe webhook:
#    - URL: https://yourdomain.com/stripe-webhook
#    - Events: checkout.session.completed
